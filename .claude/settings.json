{
  "permissions": {
    "allow": [
      "Bash(uv sync:*)",
      "Bash(uv add:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run lint-imports:*)",
      "Bash(uv run python tools/progress.py:*)",
      "Bash(uv run loom:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git worktree:*)",
      "Bash(ls:*)",
      "Bash(head:*)",
      "Bash(wc:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./var/packs/**/raw_company/**)",
      "Bash(git push:*)",
      "Bash(rm -rf:*)"
    ]
  },
  "env": {
    "LOOM_LLM_FAKE": "1",
    "LOOM_STORE": "memory",
    "LOOM_EMBEDDER": "hash"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/tools/hooks/session_start.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/tools/hooks/post_edit.sh" }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/tools/hooks/pre_compact.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/tools/hooks/stop_check.sh" }
        ]
      }
    ]
  }
}
